# Copy to .env — n8n API key for the n8n-mcp server (create in n8n: Settings → n8n API)
N8N_API_KEY=

# Internal service base URLs (spec §2, amended: LM Studio replaces Ollama for triage)
# NOTE: from inside the n8n container, "localhost" is the container — use host.docker.internal
CRAWL4AI_URL=http://host.docker.internal:11235
LMSTUDIO_URL=http://host.docker.internal:1234
LMSTUDIO_MODEL=qwen/qwen3.5-9b
# LM Studio server has auth enabled — key lives in LM Studio → Developer tab; configure as n8n credential
LMSTUDIO_API_KEY=

# Default discovery queries, JSON array (spec §5.1 — Wasim fills before Phase 3)
SCOUT_DEFAULT_QUERIES=[]
